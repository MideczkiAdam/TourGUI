<Window x:Class="TourGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="dataDg" SelectionMode="Single" SelectionUnit="FullRow" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="dataDg_SelectionChanged"/>
        <StackPanel Grid.Column="1">
            <Label x:Name="szakaszLb" Content="5. szakasz eredménye:"/>
            <Button Content="Csapatonként versenyzők száma" Click="Button_Click"/>
            <ListBox Height="100" x:Name="csapatonkentLista" d:ItemsSource="{d:SampleData ItemCount=5}"/>
            <Button x:Name="magyarBtn" Content="Magyar versenyzők száma" Click="magyarBtn_Click"/>
        </StackPanel>

    </Grid>
</Window>
